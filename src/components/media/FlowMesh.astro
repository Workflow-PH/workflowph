---
/**
 * Signature motif: a slow node-and-edge mesh, the visual shorthand for
 * automation. Pure SVG + CSS, zero JavaScript, ~2 KB, decorative only.
 *
 * Kept at very low opacity — it should register as texture, not as an
 * illustration. Illustration-led design reads student org.
 */
interface Props {
  class?: string;
  /** Multiplier on the base opacity. */
  intensity?: number;
}

const { class: className = '', intensity = 1 } = Astro.props;

const nodes = [
  [8, 24], [22, 14], [22, 40], [38, 28], [38, 62],
  [54, 18], [54, 46], [70, 32], [70, 70], [86, 24], [86, 54], [96, 40],
] as const;

const edges = [
  [0, 1], [0, 2], [1, 3], [2, 3], [2, 4], [3, 5], [3, 6],
  [4, 6], [5, 7], [6, 7], [6, 8], [7, 9], [7, 10], [8, 10], [9, 11], [10, 11],
] as const;
---

<div
  class:list={['pointer-events-none absolute inset-0 overflow-hidden', className]}
  aria-hidden="true"
  style={`--mesh-intensity:${intensity}`}
>
  <svg
    class="flow-mesh h-full w-full"
    viewBox="0 0 100 80"
    preserveAspectRatio="xMidYMid slice"
    fill="none"
  >
    <g class="mesh-edges">
      {
        edges.map(([a, b], i) => {
          const [x1, y1] = nodes[a]!;
          const [x2, y2] = nodes[b]!;
          return (
            <line
              x1={x1}
              y1={y1}
              x2={x2}
              y2={y2}
              stroke="currentColor"
              stroke-width="0.12"
              style={`--i:${i}`}
            />
          );
        })
      }
    </g>
    <g class="mesh-pulses">
      {
        edges.slice(0, 8).map(([a, b], i) => {
          const [x1, y1] = nodes[a]!;
          const [x2, y2] = nodes[b]!;
          return (
            <line
              x1={x1}
              y1={y1}
              x2={x2}
              y2={y2}
              stroke="currentColor"
              stroke-width="0.22"
              stroke-linecap="round"
              stroke-dasharray="1.5 30"
              style={`--i:${i}`}
            />
          );
        })
      }
    </g>
    <g class="mesh-nodes">
      {nodes.map(([cx, cy], i) => <circle cx={cx} cy={cy} r="0.5" fill="currentColor" style={`--i:${i}`} />)}
    </g>
  </svg>
</div>

<style>
  .flow-mesh {
    color: var(--color-flow);
  }

  .mesh-edges {
    opacity: calc(0.16 * var(--mesh-intensity));
  }

  .mesh-nodes {
    opacity: calc(0.5 * var(--mesh-intensity));
  }

  .mesh-pulses {
    opacity: calc(0.55 * var(--mesh-intensity));
  }

  @media (prefers-reduced-motion: no-preference) {
    .mesh-pulses line {
      animation: mesh-travel 9s linear infinite;
      animation-delay: calc(var(--i) * -1.1s);
    }

    .mesh-nodes circle {
      animation: mesh-breathe 6s ease-in-out infinite;
      animation-delay: calc(var(--i) * -0.4s);
    }
  }

  @keyframes mesh-travel {
    from {
      stroke-dashoffset: 32;
    }
    to {
      stroke-dashoffset: -32;
    }
  }

  @keyframes mesh-breathe {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }
</style>
