---
import { Icon } from 'astro-icon/components';
import Container from '../primitives/Container.astro';
import Wordmark from './Wordmark.astro';
import { nav } from '../../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!-- retro-style: the floating glass navbar becomes a Win98 taskbar. -->
<header class="sticky top-0 z-50" data-header>
  <div class="bevel-out flex w-full items-center justify-between gap-3 bg-ink-950 px-2 py-1.5">
    <a
      href="/"
      class="bevel-btn flex shrink-0 items-center gap-2 bg-ink-950 px-2 py-1 hover:bg-ink-900"
      aria-label="WorkFlow PH — home"
    >
      <Wordmark class="h-5 w-auto sm:h-6" instance="header" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1" role="list">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'flex items-center px-3 py-1 text-[0.8125rem] font-bold',
                  isCurrent(item.href)
                    ? 'bevel-in bg-ink-900 text-ink-50'
                    : 'border-2 border-transparent text-ink-300 hover:text-ink-50 hover:underline',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/join"
        class="bevel-btn titlebar hidden items-center gap-1.5 px-3 py-1 text-[0.8125rem] font-bold sm:inline-flex"
      >
        <span>Join us</span>
        <Icon name="lucide:arrow-up-right" class="size-3.5" aria-hidden="true" />
      </a>

      <button
        type="button"
        class="bevel-btn inline-flex items-center justify-center bg-ink-950 p-2.5 text-ink-50 hover:bg-ink-900 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <Icon name="lucide:menu" class="size-5" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer. Rendered outside the sticky header so the backdrop covers the viewport. -->
<div
  id="mobile-nav"
  class="fixed inset-0 z-[60] hidden lg:hidden"
  data-menu-panel
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
>
  <div class="absolute inset-0 bg-desktop/90" data-menu-backdrop></div>

  <div class="bevel-out win-shadow relative m-2 flex h-[calc(100%-1rem)] flex-col bg-ink-950">
    <div class="titlebar flex items-center justify-between gap-3 px-2 py-1">
      <span class="font-display text-[0.8125rem] font-bold">Menu — WorkFlow PH</span>
      <button
        type="button"
        class="bevel-btn flex size-6 items-center justify-center bg-ink-950 text-ink-50"
        aria-label="Close menu"
        data-menu-close
      >
        <Icon name="lucide:x" class="size-3.5" aria-hidden="true" />
      </button>
    </div>

    <Container class="flex-1 overflow-y-auto">
      <nav aria-label="Mobile" class="py-8">
        <ul class="flex flex-col gap-1" role="list">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class:list={[
                    'flex items-center justify-between px-4 py-3 font-display text-[1.375rem] font-bold',
                    isCurrent(item.href)
                      ? 'bevel-in bg-ink-900 text-navy'
                      : 'text-ink-100 hover:bg-ink-900 hover:text-navy',
                  ]}
                >
                  <span>{item.label}</span>
                  {isCurrent(item.href) && <span class="size-2 bg-navy" />}
                </a>
              </li>
            ))
          }
        </ul>

        <a
          href="/join"
          class="bevel-btn titlebar mt-8 flex w-full items-center justify-center gap-2 px-6 py-3 font-bold"
        >
          <span>Join WorkFlow PH</span>
          <Icon name="lucide:arrow-right" class="size-4" />
        </a>
      </nav>
    </Container>
  </div>
</div>

<script>
  // Mobile drawer behaviour. Focus trap included: a modal that leaks focus is
  // worse than no modal. (The old condense-on-scroll effect went with the
  // glass navbar; a taskbar doesn't condense.)
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const closers = document.querySelectorAll('[data-menu-close],[data-menu-backdrop]');

  if (toggle && panel) {
    const FOCUSABLE = 'a[href],button:not([disabled])';
    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      panel.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      panel.querySelector<HTMLElement>(FOCUSABLE)?.focus();
    };

    const close = () => {
      panel.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      lastFocused?.focus();
    };

    toggle.addEventListener('click', open);
    closers.forEach((el) => el.addEventListener('click', close));

    document.addEventListener('keydown', (e) => {
      if (panel.classList.contains('hidden')) return;

      if (e.key === 'Escape') {
        close();
        return;
      }

      if (e.key === 'Tab') {
        const items = Array.from(panel.querySelectorAll<HTMLElement>(FOCUSABLE));
        if (!items.length) return;
        const first = items[0]!;
        const last = items[items.length - 1]!;
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
