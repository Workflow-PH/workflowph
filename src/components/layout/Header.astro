---
import { Icon } from 'astro-icon/components';
import Container from '../primitives/Container.astro';
import Wordmark from './Wordmark.astro';
import { nav } from '../../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 px-3 pt-3 sm:px-6 sm:pt-4" data-header>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-full border border-ink-100/10 bg-ink-950/80 px-4 py-2.5 shadow-[0_8px_32px_rgba(0,0,0,0.45)] backdrop-blur-xl transition-all duration-[--dur-base] ease-[--ease-out-quart] sm:px-6 sm:py-3"
    data-header-bg
  >
    <a
      href="/"
      class="shrink-0 rounded-full transition-opacity duration-[--dur-fast] hover:opacity-85"
      aria-label="WorkFlow PH — home"
    >
      <Wordmark class="h-6 w-auto sm:h-7" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul
        class="flex items-center gap-1 rounded-full border border-ink-100/5 bg-ink-900/50 p-1"
        role="list"
      >
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'relative flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-[0.8125rem] font-medium transition-all duration-[--dur-fast]',
                  isCurrent(item.href)
                    ? 'border border-ink-100/10 bg-ink-100/10 text-ink-50 shadow-sm'
                    : 'text-ink-300 hover:bg-ink-100/5 hover:text-ink-50',
                ]}
              >
                {item.label}
                {isCurrent(item.href) && (
                  <span
                    class="inline-block size-1.5 rounded-full bg-gradient-to-r from-flow to-ember"
                    aria-hidden="true"
                  />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/join"
        class="group hidden items-center gap-1.5 rounded-full bg-gradient-to-r from-flow via-flow-300 to-ember-300 px-4.5 py-2 text-[0.8125rem] font-semibold text-ink-950 shadow-md shadow-flow/20 transition-all duration-[--dur-fast] hover:scale-[1.02] hover:shadow-ember/25 active:scale-[0.98] sm:inline-flex"
      >
        <span>Join us</span>
        <Icon
          name="lucide:arrow-up-right"
          class="size-3.5 text-ink-950 transition-transform duration-[--dur-fast] group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          aria-hidden="true"
        />
      </a>

      <button
        type="button"
        class="inline-flex items-center justify-center rounded-full border border-ink-100/10 bg-ink-900/60 p-2 text-ink-200 transition-colors hover:border-flow/40 hover:text-flow lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <Icon name="lucide:menu" class="size-5" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer. Rendered outside the sticky header so the backdrop covers the viewport. -->
<div
  id="mobile-nav"
  class="fixed inset-0 z-[60] hidden lg:hidden"
  data-menu-panel
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
>
  <div class="absolute inset-0 bg-ink-950/85 backdrop-blur-md" data-menu-backdrop></div>

  <div class="relative flex h-full flex-col">
    <Container>
      <div class="flex items-center justify-between py-4">
        <Wordmark class="h-6 w-auto" />
        <button
          type="button"
          class="inline-flex items-center justify-center rounded-full border border-ink-100/10 bg-ink-900/60 p-2 text-ink-200 hover:text-flow"
          aria-label="Close menu"
          data-menu-close
        >
          <Icon name="lucide:x" class="size-5" aria-hidden="true" />
        </button>
      </div>
    </Container>

    <Container class="flex-1 overflow-y-auto">
      <nav aria-label="Mobile" class="py-8">
        <ul class="flex flex-col gap-1" role="list">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class:list={[
                    'flex items-center justify-between rounded-xl px-4 py-3 font-display text-[1.75rem] font-semibold tracking-tight transition-colors',
                    isCurrent(item.href)
                      ? 'bg-ink-900/80 text-flow'
                      : 'text-ink-100 hover:bg-ink-900/50 hover:text-flow',
                  ]}
                >
                  <span>{item.label}</span>
                  {isCurrent(item.href) && (
                    <span class="size-2 rounded-full bg-gradient-to-r from-flow to-ember" />
                  )}
                </a>
              </li>
            ))
          }
        </ul>

        <a
          href="/join"
          class="mt-8 flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-flow via-flow-300 to-ember-300 px-6 py-3.5 font-semibold text-ink-950 shadow-lg shadow-flow/20 transition-all hover:brightness-105 active:scale-[0.98]"
        >
          <span>Join WorkFlow PH</span>
          <Icon name="lucide:arrow-right" class="size-4" />
        </a>
      </nav>
    </Container>
  </div>
</div>

<script>
  // ~1 KB of behaviour: condense-on-scroll and the mobile drawer.
  // Focus trap included — a modal that leaks focus is worse than no modal.
  const header = document.querySelector<HTMLElement>('[data-header-bg]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const closers = document.querySelectorAll('[data-menu-close],[data-menu-backdrop]');

  if (header) {
    const onScroll = () => {
      const scrolled = window.scrollY > 20;
      header.classList.toggle('shadow-[0_12px_40px_rgba(0,0,0,0.7)]', scrolled);
      header.classList.toggle('border-ink-100/20', scrolled);
      header.classList.toggle('bg-ink-950/95', scrolled);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (toggle && panel) {
    const FOCUSABLE = 'a[href],button:not([disabled])';
    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      panel.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      panel.querySelector<HTMLElement>(FOCUSABLE)?.focus();
    };

    const close = () => {
      panel.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      lastFocused?.focus();
    };

    toggle.addEventListener('click', open);
    closers.forEach((el) => el.addEventListener('click', close));

    document.addEventListener('keydown', (e) => {
      if (panel.classList.contains('hidden')) return;

      if (e.key === 'Escape') {
        close();
        return;
      }

      if (e.key === 'Tab') {
        const items = Array.from(panel.querySelectorAll<HTMLElement>(FOCUSABLE));
        if (!items.length) return;
        const first = items[0]!;
        const last = items[items.length - 1]!;
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
