---
import Container from '../primitives/Container.astro';
import Button from '../primitives/Button.astro';
import FlowMesh from '../media/FlowMesh.astro';
import { site } from '../../lib/site';

interface Props {
  eventCount: number;
}
const { eventCount } = Astro.props;
---

<section class="relative isolate flex min-h-[88svh] items-end overflow-hidden pt-24 pb-16 lg:min-h-[92svh] lg:pb-24">
  <!-- Layer 1: node mesh. Replace with the hero photograph once assets land (WF-A2). -->
  <FlowMesh class="opacity-90" intensity={1} />

  <!-- Layer 2: vignette so the headline always has contrast, photo or not. -->
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_80%_at_50%_0%,transparent,var(--color-ink-950)_75%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-ink-950 to-transparent"
    aria-hidden="true"
  >
  </div>

  <Container class="relative">
    <div class="flex flex-col gap-8">
      <p class="kicker flex items-center gap-3">
        <span class="inline-block h-px w-8 bg-flow" aria-hidden="true"></span>
        Volunteer-run · Philippines
      </p>

      <h1 class="max-w-[18ch] text-[length:var(--text-hero)] font-semibold">
        Building the <span class="text-flow">automation</span> landscape of the Philippines.
      </h1>

      <p class="max-w-[52ch] text-[length:var(--text-lead)] leading-relaxed text-ink-300">
        WorkFlow PH is a volunteer-driven community of builders. We run workshops
        and community days, platform Filipino engineers, and publish the automations
        we build so anyone can use them.
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <Button href="/showcase" variant="primary" icon="lucide:arrow-right">
          See our work
        </Button>
        <Button href="/partners#partner-with-us" variant="secondary">
          Partner with us
        </Button>
      </div>

      <p class="font-mono text-[length:var(--text-meta)] text-ink-500">
        {eventCount} events on record · <a
          href={site.socials[0].url}
          rel="noopener noreferrer"
          target="_blank"
          class="underline decoration-ink-600 underline-offset-4 transition-colors hover:text-flow">1,500+ builders following along</a
        >
      </p>
    </div>
  </Container>

  <!-- Scroll affordance. Hidden from AT, hidden under reduced motion. -->
  <div
    class="pointer-events-none absolute right-5 bottom-8 hidden flex-col items-center gap-2 motion-safe:lg:flex"
    aria-hidden="true"
  >
    <span class="kicker [writing-mode:vertical-rl] text-ink-600">Scroll</span>
    <span class="h-12 w-px bg-gradient-to-b from-ink-600 to-transparent"></span>
  </div>
</section>
