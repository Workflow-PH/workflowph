---
import Container from '../primitives/Container.astro';
import Button from '../primitives/Button.astro';
import Window from '../primitives/Window.astro';
import { site } from '../../lib/site';

/**
 * retro-style: the full-viewport mesh hero becomes a welcome dialog sitting on
 * the desktop, like a Win98 first-boot screen.
 */
interface Props {
  /** Sponsor-facing "events run" figure, sourced from the stats collection so
   *  the hero and the impact bar can never disagree. */
  eventsRun: string;
}
const { eventsRun } = Astro.props;
---

<section class="pt-10 pb-4 sm:pt-16 sm:pb-6">
  <Container>
    <Window
      caption="Welcome — WorkFlow PH"
      class="mx-auto max-w-3xl"
      bodyClass="flex flex-col gap-6 p-6 sm:p-10"
    >
        <p class="kicker">Volunteer-run · Philippines</p>

        <h1 class="max-w-[22ch] text-[length:var(--text-hero)] text-brand-white">
          Building the automation landscape of the Philippines.
        </h1>

        <p class="max-w-[52ch] text-[length:var(--text-lead)] leading-relaxed text-ink-300">
          WorkFlow PH is a volunteer-run community of builders. We run workshops
          and community days, put Filipino engineers on stage, and publish the
          automations we build.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <Button href="/showcase" variant="primary" icon="lucide:arrow-right">
            See our work
          </Button>
          <Button href="/partners#partner-with-us" variant="secondary">
            Partner with us
          </Button>
        </div>

        <p class="bevel-in bg-ink-900 px-3 py-2 font-mono text-[length:var(--text-meta)] text-ink-400">
          {eventsRun} events run · <a
            href={site.socials[0].url}
            rel="noopener noreferrer"
            target="_blank"
            class="text-flow underline underline-offset-2 hover:text-flow-600">1,500+ builders following along</a
          >
        </p>
    </Window>
  </Container>
</section>
