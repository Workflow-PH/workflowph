---
import Container from '../primitives/Container.astro';
import Button from '../primitives/Button.astro';
import FlowMesh from '../media/FlowMesh.astro';
import { site } from '../../lib/site';

interface Props {
  eventsRun: string;
}
const { eventsRun } = Astro.props;
---

<section class="relative isolate flex min-h-[82svh] items-end overflow-hidden pt-24 pb-14 lg:min-h-[86svh] lg:pb-20">
  <FlowMesh class="opacity-70" intensity={1} />
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_15%_25%,color-mix(in_oklab,var(--color-flow)_10%,transparent),transparent_70%),radial-gradient(ellipse_55%_45%_at_85%_65%,color-mix(in_oklab,var(--color-ember)_8%,transparent),transparent_70%)]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_80%_at_50%_0%,transparent,var(--color-ink-950)_78%)]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-ink-950 to-transparent" aria-hidden="true"></div>

  <Container class="relative">
    <div class="flex flex-col gap-7">
      <p class="hero-in w-fit rotate-[-1.5deg] rounded-md border border-ink-950 bg-beam px-3 py-1.5 font-mono text-[0.6875rem] font-semibold tracking-[0.14em] text-ink-950 uppercase shadow-[3px_3px_0_0_var(--color-flow)]" style="--d:0ms">
        Volunteer-run · Philippines
      </p>
      <h1 class="max-w-[20ch] text-[length:var(--text-hero)] font-semibold text-brand-white">
        <span class="hero-in block" style="--d:60ms">Building the</span>
        <span class="hero-in block" style="--d:140ms">
          <span class="relative inline-block px-1">
            <span class="absolute inset-x-0 bottom-[0.08em] h-[0.22em] -rotate-1 rounded-sm bg-flow/85" aria-hidden="true"></span>
            <span class="relative">automation</span>
          </span> landscape
        </span>
        <span class="hero-in block" style="--d:220ms">of the Philippines.</span>
      </h1>
      <p class="hero-in max-w-[52ch] text-[length:var(--text-lead)] leading-relaxed text-ink-300" style="--d:300ms">
        WorkFlow PH is a volunteer-driven community of builders. We run workshops
        and community days, platform Filipino engineers, and publish the automations
        we build so anyone can use them.
      </p>
      <div class="hero-in flex flex-wrap items-center gap-3" style="--d:380ms">
        <Button href="/showcase" variant="primary" icon="lucide:arrow-right">See our work</Button>
        <Button href="/partners#partner-with-us" variant="secondary">Partner with us</Button>
      </div>
      <p class="hero-in font-mono text-[length:var(--text-meta)] text-ink-400" style="--d:440ms">
        {eventsRun} events run · <a href={site.socials[0].url} rel="noopener noreferrer" target="_blank" class="underline decoration-ink-600 underline-offset-4 transition-colors hover:text-flow">1,500+ builders following along</a>
      </p>
    </div>
  </Container>
  <div class="pointer-events-none absolute right-5 bottom-8 hidden flex-col items-center gap-2 motion-safe:lg:flex" aria-hidden="true">
    <span class="kicker [writing-mode:vertical-rl] text-ink-600">Scroll</span>
    <span class="h-12 w-px bg-gradient-to-b from-ink-600 to-transparent"></span>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      opacity: 0;
      translate: 0 18px;
      animation: hero-rise 0.9s var(--ease-out-expo, cubic-bezier(0.16,1,0.3,1)) forwards;
      animation-delay: var(--d, 0ms);
    }
  }
  @keyframes hero-rise {
    to { opacity: 1; translate: 0 0; }
  }
</style>
