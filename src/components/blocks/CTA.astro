---
import Container from '../primitives/Container.astro';
import Button from '../primitives/Button.astro';
import Window from '../primitives/Window.astro';
import { site } from '../../lib/site';

/** retro-style: the closing CTA is a two-pane dialog window. */
---

<section class="py-4 sm:py-6">
  <Container>
    <Window
      caption="Get involved"
      controls={false}
      bodyClass="grid gap-10 p-5 sm:p-8 lg:grid-cols-2 lg:gap-16 lg:p-10"
    >
      <div class="hairline flex flex-col gap-4 lg:border-r lg:pr-16" data-reveal>
        <p class="kicker flex items-center gap-3">
          <span class="inline-block h-px w-8 bg-ember" aria-hidden="true"></span>
          For organisations
        </p>
        <h2 class="text-[length:var(--text-h2)]">Partner with us</h2>
        <p class="max-w-md leading-relaxed text-ink-300">
          Reach Filipino builders who ship. We run workshops, community days, and
          collaborations with organisations that want to invest in local technical
          talent.
        </p>
        <div class="mt-2 flex flex-wrap gap-3">
          <Button href="/partners#partner-with-us" variant="primary" icon="lucide:arrow-right">
            What partnership looks like
          </Button>
          <Button
            href={`mailto:${site.email}?subject=Partnership%20enquiry%20—%20WorkFlow%20PH`}
            variant="ghost"
          >
            {site.email}
          </Button>
        </div>
      </div>

      <div class="flex flex-col gap-4" data-reveal>
        <p class="kicker flex items-center gap-3">
          <span class="inline-block h-px w-8 bg-flow" aria-hidden="true"></span>
          For builders
        </p>
        <h2 class="text-[length:var(--text-h2)]">Volunteer with us</h2>
        <p class="max-w-md leading-relaxed text-ink-300">
          Everything here was built by volunteers. If you want to run events,
          write automations, design, or shoot photos for the community, there's
          room.
        </p>
        <div class="mt-2">
          <Button href="/join" variant="secondary" icon="lucide:arrow-right">
            Join WorkFlow PH
          </Button>
        </div>
      </div>
    </Window>
  </Container>
</section>
