---
import type { CollectionEntry } from 'astro:content';
import Container from '../primitives/Container.astro';
import Window from '../primitives/Window.astro';
import { formatDate } from '../../lib/format';

/**
 * Public numbers carry an `asOf` date and a known source. A sponsor can tell the
 * difference between a counted figure and a rounded guess, so we show our work.
 */
interface Props {
  stats: CollectionEntry<'stats'>[];
}
const { stats } = Astro.props;

// A stat without a real value yet is not shown. An em-dash cell in the middle
// of the sponsor-facing numbers reads as a bug, not as honesty.
const shown = stats.filter((s) => s.data.value.trim() !== '—');
---

<section aria-label="Impact at a glance" class="py-4 sm:py-6">
  <Container>
    <Window caption="Impact — at a glance" controls={false}>
      <dl class:list={['grid grid-cols-2 p-4 sm:p-6', shown.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4']}>
      {
        shown.map((s, i) => (
          <div
            class:list={[
              'hairline flex flex-col gap-2 px-1 py-8 sm:py-10',
              i % 2 === 1 && 'border-l pl-6 sm:pl-8',
              i >= 2 && 'border-t lg:border-t-0',
              i > 0 && 'lg:border-l lg:pl-6 sm:lg:pl-8',
            ]}
          >
            {/* beam (brand yellow) is rationed to exactly this: the numbers a
                sponsor scans first. It is the brightest thing in the palette,
                so it earns the most important job on the page. */}
            <dd
              data-stat
              class="font-display text-[clamp(1.75rem,3.5vw,2.75rem)] leading-none font-bold text-beam"
            >
              {s.data.value}
            </dd>
            <dt class="font-mono text-[0.6875rem] tracking-[0.14em] text-ink-400 uppercase">
              {s.data.label}
            </dt>
            <p class="font-mono text-[0.625rem] text-ink-400">
              as of <time datetime={s.data.asOf.toISOString()}>{formatDate(s.data.asOf)}</time>
            </p>
          </div>
        ))
      }
      </dl>
    </Window>
  </Container>
</section>
