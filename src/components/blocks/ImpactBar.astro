---
import type { CollectionEntry } from 'astro:content';
import Container from '../primitives/Container.astro';
import { formatDate } from '../../lib/format';

interface Props {
  stats: CollectionEntry<'stats'>[];
}
const { stats } = Astro.props;
const shown = stats.filter((s) => s.data.value.trim() !== '—');
---

<section aria-label="Impact at a glance" class="hairline border-y bg-ink-900/40">
  <Container>
    <dl class:list={['grid grid-cols-2', shown.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4']}>
      {shown.map((s, i) => (
        <div class:list={['hairline flex flex-col gap-2 px-1 py-8 sm:py-10', i % 2 === 1 && 'border-l pl-6 sm:pl-8', i >= 2 && 'border-t lg:border-t-0', i > 0 && 'lg:border-l lg:pl-6 sm:lg:pl-8']}>
          <dd data-stat data-ticker={s.data.value} class="font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-none font-semibold tracking-tight text-beam tabular-nums">
            {s.data.value}
          </dd>
          <dt class="font-mono text-[0.6875rem] tracking-[0.14em] text-ink-400 uppercase">{s.data.label}</dt>
          <p class="font-mono text-[0.625rem] text-ink-400">as of <time datetime={s.data.asOf.toISOString()}>{formatDate(s.data.asOf)}</time></p>
        </div>
      ))}
    </dl>
  </Container>
</section>

<script>
  const els = document.querySelectorAll('[data-ticker]');
  const parse = (raw: string): { n: number; plus: string; suffix: string } | null => {
    const m = raw.match(/([\d,]+)(\+?)(.*)/);
    if (!m || !m[1]) return null;
    return { n: parseInt(m[1].replace(/,/g, ''), 10), plus: m[2] ?? '', suffix: m[3] ?? '' };
  };
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const el = e.target as HTMLElement;
      io.unobserve(el);
      const p = parse(el.getAttribute('data-ticker') ?? '');
      if (!p || Number.isNaN(p.n)) continue;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
      const t0 = performance.now();
      const dur = 1100;
      const tick = (t: number): void => {
        const k = Math.min(1, (t - t0) / dur);
        const ease = 1 - Math.pow(1 - k, 4);
        el.textContent = Math.round(p.n * ease).toLocaleString('en-US') + p.plus + p.suffix;
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }, { threshold: 0.4 });
  els.forEach((el) => io.observe(el));
</script>
