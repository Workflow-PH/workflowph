---
import { Icon } from 'astro-icon/components';

interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary' | 'ember' | 'ghost';
  size?: 'sm' | 'md';
  icon?: string;
  external?: boolean;
  class?: string;
  'aria-label'?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  icon,
  external,
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2 rounded-[--radius-pill] font-medium transition-all duration-[--dur-fast] ease-[--ease-out-quart] whitespace-nowrap';

const variants = {
  primary:
    'bg-gradient-to-r from-flow via-flow-300 to-ember-300 text-ink-950 font-semibold shadow-md shadow-flow/20 hover:shadow-ember/25 hover:scale-[1.02] active:scale-[0.98]',
  ember:
    'bg-ember text-ink-950 font-semibold shadow-md shadow-ember/20 hover:bg-ember-300 hover:scale-[1.02] active:scale-[0.98]',
  secondary:
    'border border-ink-100/15 bg-ink-900/50 text-ink-100 backdrop-blur-sm hover:border-flow/40 hover:bg-flow/10 hover:text-ink-50 active:scale-[0.98]',
  ghost: 'text-ink-300 hover:text-ink-50 hover:bg-ink-100/5',
};

const sizes = {
  sm: 'px-4 py-2 text-[0.8125rem]',
  md: 'px-6 py-3 text-sm',
};

const classes = [base, variants[variant], sizes[size], className];
const isExternal = external ?? (href?.startsWith('http') || href?.startsWith('mailto:'));
---

{
  href ? (
    <a
      href={href}
      class:list={classes}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      target={isExternal && href.startsWith('http') ? '_blank' : undefined}
      {...rest}
    >
      <slot />
      {icon && <Icon name={icon} class="size-4 shrink-0 transition-transform duration-[--dur-fast] group-hover:translate-x-0.5" aria-hidden="true" />}
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
      {icon && <Icon name={icon} class="size-4 shrink-0" aria-hidden="true" />}
    </button>
  )
}
