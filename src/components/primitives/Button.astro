---
import { Icon } from 'astro-icon/components';

interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'secondary' | 'ember' | 'ghost';
  size?: 'sm' | 'md';
  icon?: string;
  external?: boolean;
  class?: string;
  'aria-label'?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  icon,
  external,
  class: className = '',
  ...rest
} = Astro.props;

/* retro-style: buttons are bevelled Win98 controls. Primary carries the extra
   black keyline the OS gave the default button; ghost is a classic hyperlink. */
const base =
  'group inline-flex items-center justify-center gap-2 font-bold whitespace-nowrap select-none';

const variants = {
  primary:
    'bevel-btn bg-ink-950 text-ink-50 shadow-[0_0_0_1px_#000] hover:bg-ink-900 active:translate-y-px',
  ember:
    'bevel-btn titlebar hover:brightness-110 active:translate-y-px',
  secondary: 'bevel-btn bg-ink-950 text-ink-50 hover:bg-ink-900 active:translate-y-px',
  ghost: 'font-medium text-flow underline underline-offset-2 hover:text-flow-600',
};

const sizes = {
  sm: 'px-4 py-2 text-[0.8125rem]',
  md: 'px-6 py-3 text-sm',
};

const classes = [base, variants[variant], sizes[size], className];
const isExternal = external ?? (href?.startsWith('http') || href?.startsWith('mailto:'));
---

{
  href ? (
    <a
      href={href}
      class:list={classes}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      target={isExternal && href.startsWith('http') ? '_blank' : undefined}
      {...rest}
    >
      <slot />
      {icon && <Icon name={icon} class="size-4 shrink-0 transition-transform duration-[--dur-fast] group-hover:translate-x-0.5" aria-hidden="true" />}
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
      {icon && <Icon name={icon} class="size-4 shrink-0" aria-hidden="true" />}
    </button>
  )
}
