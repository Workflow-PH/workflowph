---
import Container from './Container.astro';

interface Props {
  id?: string;
  kicker?: string;
  title?: string;
  lead?: string;
  /** Rendered top-right on desktop, below the lead on mobile. */
  align?: 'left' | 'center';
  bleed?: boolean;
  width?: 'page' | 'prose' | 'wide';
  class?: string;
  labelledby?: string;
}

const {
  id,
  kicker,
  title,
  lead,
  align = 'left',
  bleed = false,
  width = 'page',
  class: className = '',
  labelledby,
} = Astro.props;

const headingId = id ? `${id}-title` : undefined;
---

<section
  id={id}
  aria-labelledby={labelledby ?? (title ? headingId : undefined)}
  class:list={['py-16 sm:py-24 lg:py-32', className]}
>
  <Container width={bleed ? 'wide' : width}>
    {
      (kicker || title || lead) && (
        <header
          class:list={[
            'mb-10 flex flex-col gap-4 sm:mb-14',
            align === 'center' && 'items-center text-center',
          ]}
          data-reveal
        >
          {kicker && <p class="kicker">{kicker}</p>}
          {
            title && (
              <h2 id={headingId} class="text-[length:var(--text-display)]">
                {title}
              </h2>
            )
          }
          {
            lead && (
              <p
                class:list={[
                  'text-[length:var(--text-lead)] leading-relaxed text-ink-300',
                  align === 'center' ? 'max-w-2xl' : 'max-w-2xl',
                ]}
              >
                {lead}
              </p>
            )
          }
          <slot name="header-aside" />
        </header>
      )
    }
    <slot />
  </Container>
</section>
