---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { eventTypeLabels } from '../../lib/site';
import { formatDate } from '../../lib/format';

interface Props {
  entries: CollectionEntry<'showcase'>[];
}
const { entries } = Astro.props;
---

<ul class="hairline divide-y divide-ink-100/10 border-t border-ink-100/10" role="list">
  {entries.map((entry) => {
    const primary = entry.data.links[0];
    const Row = primary ? 'a' : 'div';
    const thumb = entry.data.card ?? entry.data.hero;
    return (
      <li>
        <Row
          href={primary?.url}
          rel={primary ? 'noopener noreferrer' : undefined}
          target={primary ? '_blank' : undefined}
          class:list={['group grid grid-cols-[3.5rem_1fr] items-center gap-x-5 py-4 sm:grid-cols-[7.5rem_3.5rem_1fr_auto] sm:gap-x-6', primary && 'transition-colors duration-[--dur-fast] hover:bg-ink-100/[0.03]']}
        >
          <time datetime={entry.data.date.toISOString()} class="hidden font-mono text-[length:var(--text-meta)] text-ink-500 tabular-nums sm:block">
            {formatDate(entry.data.date)}
          </time>
          {thumb ? (
            <img src={thumb.src} alt="" loading="lazy" decoding="async" class="size-14 rounded-md border border-ink-100/15 object-cover shadow-[2px_2px_0_0_var(--color-ink-800)] transition-transform duration-[--dur-base] ease-[--ease-out-expo] group-hover:-rotate-2 group-hover:scale-[1.04]" />
          ) : (
            <span class="flex size-14 items-center justify-center rounded-md border border-dashed border-ink-100/15 font-mono text-[0.625rem] text-ink-600" aria-hidden="true">
              {formatDate(entry.data.date).slice(-4)}
            </span>
          )}
          <span class="flex min-w-0 flex-col gap-0.5">
            <span class="font-mono text-[length:var(--text-meta)] text-ink-500 tabular-nums sm:hidden">{formatDate(entry.data.date)}</span>
            <span class="truncate text-[0.9375rem] leading-snug font-medium text-ink-100 transition-colors group-hover:text-flow-100">{entry.data.title}</span>
            <span class="truncate font-mono text-[0.625rem] tracking-[0.12em] text-ink-500 uppercase">{entry.data.series ? `${entry.data.series} — ` : ''}{eventTypeLabels[entry.data.type]}</span>
          </span>
          <span class="hidden sm:block" aria-hidden="true">
            {primary && <Icon name="lucide:arrow-up-right" class="size-4 text-ink-600 transition-all duration-[--dur-fast] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-flow" />}
          </span>
        </Row>
      </li>
    );
  })}
</ul>
