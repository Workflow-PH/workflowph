---
import Base from '../layouts/Base.astro';
import Container from '../components/primitives/Container.astro';
import Section from '../components/primitives/Section.astro';
import BuildCard from '../components/blocks/BuildCard.astro';
import CTA from '../components/blocks/CTA.astro';
import { getBuilds, groupBy } from '../lib/content';
import { buildKindLabels } from '../lib/site';

const builds = await getBuilds();
const byKind = groupBy(builds, (b) => b.data.kind);
---

<Base
  title="Builds"
  description="Automation workflows, templates, playbooks, and talks produced by the WorkFlow PH community — free to fork and run."
>
  <section class="pt-32 pb-12 lg:pt-40 lg:pb-16">
    <Container>
      <div class="flex flex-col gap-6">
        <p class="kicker flex items-center gap-3">
          <span class="inline-block h-px w-8 bg-flow" aria-hidden="true"></span>
          Builds
        </p>
        <h1 class="max-w-[24ch] text-[length:var(--text-display)]">
          The stuff we actually ship.
        </h1>
        <p class="max-w-[58ch] text-[length:var(--text-lead)] leading-relaxed text-ink-300">
          Running events is half of it. The other half is publishing the automations,
          templates, and playbooks our community builds — so a Filipino builder can
          fork something and have it running the same afternoon.
        </p>
      </div>
    </Container>
  </section>

  {
    [...byKind.entries()].map(([kind, entries]) => (
      <section aria-labelledby={`kind-${kind}`} class="pb-14">
        <Container>
          <div class="hairline mb-6 flex items-baseline gap-4 border-t pt-5">
            <h2
              id={`kind-${kind}`}
              class="font-mono text-[0.8125rem] font-medium tracking-[0.16em] text-flow uppercase"
            >
              {buildKindLabels[kind]}
            </h2>
            <span class="font-mono text-[0.6875rem] text-ink-600">{entries.length}</span>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {entries.map((entry) => (
              <BuildCard entry={entry} />
            ))}
          </div>
        </Container>
      </section>
    ))
  }

  <Section
    kicker="Contribute"
    title="Built something worth sharing?"
    lead="If you've automated something that would save another builder a week, we'll publish it here with your name on it."
    class="hairline border-t"
  >
    <p class="max-w-xl leading-relaxed text-ink-400">
      Bring it to the community channel or email us. We're building a public library,
      not a portfolio — attribution stays with whoever wrote it.
    </p>
  </Section>

  <CTA />
</Base>
