---
import Base from '../layouts/Base.astro';
import Container from '../components/primitives/Container.astro';
import Button from '../components/primitives/Button.astro';
import Window from '../components/primitives/Window.astro';
---

<Base title="Page not found" noindex>
  <section class="flex min-h-[70svh] items-center py-16">
    <Container>
      <Window
        caption="Error 404 — workflowph.exe"
        class="mx-auto max-w-xl"
        bodyClass="flex flex-col gap-6 p-6 sm:p-8"
      >
        <div class="flex items-start gap-4">
          <span
            class="bevel-in flex size-10 shrink-0 items-center justify-center bg-ink-900 font-display text-xl font-bold text-ruby"
            aria-hidden="true"
          >
            !
          </span>
          <div class="flex flex-col gap-3">
            <h1 class="text-[length:var(--text-h2)]">This route didn't resolve.</h1>
            <p class="leading-relaxed text-ink-300">
              Every good automation has an error branch. This is ours. The page you
              asked for isn't here. Try one of these instead.
            </p>
          </div>
        </div>
        <div class="flex flex-wrap justify-end gap-3">
          <Button href="/showcase" variant="primary" icon="lucide:arrow-right">
            Browse the showcase
          </Button>
          <Button href="/" variant="secondary">Back to home</Button>
        </div>
      </Window>
    </Container>
  </section>
</Base>
