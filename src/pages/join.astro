---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/primitives/PageHeader.astro';
import Section from '../components/primitives/Section.astro';
import Button from '../components/primitives/Button.astro';
import { site } from '../lib/site';

const roles = [
  {
    icon: 'lucide:workflow',
    title: 'Automation builders',
    body: 'Build and publish templates in n8n, Make, Zapier, or code. If you automate things for fun, this is the room.',
  },
  {
    icon: 'lucide:calendar-check',
    title: 'Event organisers',
    body: 'Run workshops and community days: logistics, speakers, comms, and post-event reporting.',
  },
  {
    icon: 'lucide:camera',
    title: 'Photographers & videographers',
    body: 'Every photo on this site is credited. Come shoot an event and your name goes on it.',
  },
  {
    icon: 'lucide:pen-tool',
    title: 'Designers & writers',
    body: 'Event creatives, recaps, social, and this site. Craft matters here.',
  },
  {
    icon: 'lucide:code',
    title: 'Developers',
    body: 'This site is open. So is the tooling we use to run the community.',
  },
  {
    icon: 'lucide:handshake',
    title: 'Partnerships & community',
    body: 'Talk to sponsors, universities, and other communities. Bring people in.',
  },
];
---

<Base
  title="Join us"
  description="WorkFlow PH is volunteer-run. Here's what volunteers actually do, and how to get involved."
>
  <PageHeader kicker="Join us" title="Come build the thing with us.">
    <p class="max-w-[56ch] text-[length:var(--text-lead)] leading-relaxed text-ink-300">
      WorkFlow PH runs entirely on volunteers. No prior community experience
      needed; most of us learned it here. What matters is that you follow
      through on the thing you said you'd do.
    </p>
    <div class="mt-2 flex flex-wrap gap-3">
      <Button
        href={`mailto:${site.email}?subject=I'd%20like%20to%20volunteer%20—%20WorkFlow%20PH`}
        variant="primary"
        icon="lucide:arrow-right"
      >
        Email us to get started
      </Button>
      <Button href={site.socials[0].url} variant="secondary" icon="lucide:arrow-up-right">
        Message us on Facebook
      </Button>
    </div>
  </PageHeader>

  <Section kicker="Where you'd fit" title="What volunteers actually do">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        roles.map((r) => (
          <div class="bevel-in flex flex-col gap-3 bg-ink-900 p-6" data-reveal>
            <Icon name={r.icon} class="size-5 text-flow" aria-hidden="true" />
            <h3 class="text-[1.0625rem] font-semibold text-ink-50">{r.title}</h3>
            <p class="text-sm leading-relaxed text-ink-400">{r.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section kicker="The honest version" title="Time commitment" width="prose">
    <div class="flex flex-col gap-5 leading-relaxed text-ink-300">
      <p>
        Volunteers typically contribute <strong class="text-ink-50">2 to 4 flexible hours per week</strong>.
        During the week leading up to a major workshop, Build Night, or hackathon, active leads might give a bit more,
        balanced by restful cooldown weeks after launches.
      </p>
      <p>
        <strong class="text-ink-100">Async-first by default:</strong> We favor concise messaging updates, GitHub issues,
        and documented tasks over long synchronous meetings. Quick 15-minute alignment syncs happen only when necessary.
      </p>
      <p>
        <strong class="text-ink-100">Life comes first:</strong> Your job, classes, clients, family, and health always take priority.
        If you need to step away or take a break for a few weeks, all we ask is a quick heads-up so teammates can support your work.
      </p>
    </div>
  </Section>
</Base>
