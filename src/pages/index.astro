---
import Base from '../layouts/Base.astro';
import Section from '../components/primitives/Section.astro';
import Container from '../components/primitives/Container.astro';
import Button from '../components/primitives/Button.astro';
import Hero from '../components/blocks/Hero.astro';
import ImpactBar from '../components/blocks/ImpactBar.astro';
import CTA from '../components/blocks/CTA.astro';
import BuildCard from '../components/blocks/BuildCard.astro';
import ShowcaseGrid from '../components/showcase/ShowcaseGrid.astro';
import { getShowcase, getStats, getPartners, getBuilds } from '../lib/content';

const { all, featured, upcoming } = await getShowcase();
const stats = await getStats();
const partners = await getPartners();
const builds = await getBuilds();
const withPhoto = all.filter((e) => e.data.card ?? e.data.hero);
const featuredEvents = (featured.length ? featured : withPhoto.length ? withPhoto : all).slice(0, 6);
const featuredBuilds = builds.filter((b) => b.data.featured).slice(0, 3);
const nextUp = upcoming.slice(0, 3);
const eventsRun = stats.find((s) => s.id === 'events')?.data.value ?? String(all.length);
const heroStrip = withPhoto.slice(0, 5);
---

<Base>
  <Hero eventsRun={eventsRun} />

  {heroStrip.length > 0 && (
    <section aria-label="Recent event photos" class="relative z-10 -mt-10 pb-6 lg:-mt-14">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="mask-edges overflow-hidden">
          <ul class="flex w-max items-start gap-5 pt-3" role="list">
            {heroStrip.map((e, i) => {
              const m = e.data.card ?? e.data.hero!;
              return (
                <li class:list={['tape relative shrink-0 overflow-hidden rounded-[--radius-card] border border-ink-100/15 bg-ink-900 shadow-[5px_5px_0_0_var(--color-ink-800)] transition-transform duration-[--dur-base] ease-[--ease-out-expo] hover:rotate-0 hover:scale-[1.03]', i % 2 === 0 ? 'rotate-[-1.6deg]' : 'rotate-[1.2deg] translate-y-3']}>
                  <img src={m.src} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" class="h-32 w-48 object-cover sm:h-40 sm:w-64" />
                  <p class="truncate px-3 py-2 font-mono text-[0.625rem] tracking-wide text-ink-400">{e.data.title}</p>
                </li>
              );
            })}
          </ul>
        </div>
        <p class="mt-4 font-mono text-[0.6875rem] text-ink-500">Real rooms, real builders — {withPhoto.length} events with photos on file. <a href="/showcase" class="link-swipe text-flow">Browse all</a></p>
      </div>
    </section>
  )}

  <ImpactBar stats={stats} />

  <section id="featured" aria-labelledby="featured-h" class="py-20 lg:py-28">
    <Container>
      <div class="flex items-end justify-between gap-6 border-b border-ink-100/10 pb-6">
        <div class="flex items-baseline gap-5">
          <span class="font-display text-[clamp(3rem,7vw,5.5rem)] leading-none font-semibold text-transparent tabular-nums" style="-webkit-text-stroke:1px var(--color-flow)" aria-hidden="true">01</span>
          <div>
            <p class="kicker mb-2">Selected work</p>
            <h2 id="featured-h" class="max-w-[16ch] text-[length:var(--text-h1)]">Events, workshops, collaborations.</h2>
          </div>
        </div>
        <Button href="/showcase" variant="ghost" icon="lucide:arrow-right" class="hidden shrink-0 sm:inline-flex">Browse the showcase</Button>
      </div>
      <div class="pt-10">
        <ShowcaseGrid entries={featuredEvents} />
      </div>
    </Container>
  </section>

  <section aria-label="Partners" class="relative -rotate-[0.6deg] border-y-4 border-ink-950 bg-beam py-10 text-ink-950 lg:py-12">
    <div class="mask-edges overflow-hidden">
      <ul class="flex w-max items-center gap-8 pr-8 motion-safe:animate-[marquee_28s_linear_infinite]" role="list">
        {[false, true].map((clone) => partners.map((p) => (
          <li aria-hidden={clone || undefined} class="flex shrink-0 items-center gap-8">
            <span class="font-display text-[clamp(1.5rem,3.4vw,2.5rem)] font-semibold tracking-tight whitespace-nowrap">{p.data.name}</span>
            <span class="inline-block size-2.5 rotate-45 bg-ink-950" aria-hidden="true"></span>
          </li>
        )))}
      </ul>
    </div>
    <div class="mx-auto mt-6 flex max-w-7xl flex-wrap items-center justify-between gap-4 px-5 lg:px-8">
      <p class="max-w-[46ch] text-[0.9375rem] leading-snug font-medium">Organisations that ran something with us, hosted us, or backed the community.</p>
      <a href="/partners" class="link-swipe font-mono text-[0.75rem] font-semibold tracking-[0.12em] uppercase">How partnership works →</a>
    </div>
  </section>

  <Section id="builds" kicker="What we're building" title="Not just events" lead="We publish the automations, templates, and playbooks we build so anyone in the community can fork them and run. Here's what's on the bench right now." class="hairline border-b bg-ink-900/30">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featuredBuilds.map((entry) => <BuildCard entry={entry} />)}
    </div>
    <div class="mt-10">
      <Button href="/builds" variant="secondary" icon="lucide:arrow-right">Browse all builds</Button>
    </div>
  </Section>

  <Section id="upcoming" kicker="What's next" title="Upcoming">
    {nextUp.length > 0 ? (
      <ShowcaseGrid entries={nextUp} uniform />
    ) : (
      <div class="hairline flex flex-col items-start gap-5 rounded-[--radius-card] border border-dashed p-8 sm:p-12">
        <p class="max-w-lg text-[length:var(--text-lead)] leading-relaxed text-ink-300">Nothing on the calendar right now. We announce every event on Facebook first — follow along and you'll hear about the next one before anyone else.</p>
        <div class="flex flex-wrap gap-3">
          <Button href="https://facebook.com/workflowph" variant="secondary" icon="lucide:arrow-up-right">Follow on Facebook</Button>
          <Button href="/showcase" variant="ghost" icon="lucide:arrow-right">See what past events looked like</Button>
        </div>
      </div>
    )}
  </Section>

  <CTA />
</Base>
